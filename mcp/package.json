{
  "name": "prayer-tower-mcp",
  "version": "0.1.0",
  "description": "MCP server for managing Prayer Tower prayer requests (data/prayers.json): stdio and hosted HTTP (OAuth via GitHub)",
  "type": "module",
  "private": true,
  "bin": {
    "prayer-tower-mcp": "dist/index.js",
    "prayer-tower-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "schema": "tsx scripts/gen-schema.ts",
    "extract": "tsx scripts/extract.ts",
    "smoke": "tsx scripts/smoke.ts",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
